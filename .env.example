# Copiar este archivo como .env y poner los valores reales.
# El .env debe ser IDÉNTICO en las 3 PCs y nunca se sube al repositorio.

# --- Red ---
PC1_IP=192.168.50.11
PC2_IP=192.168.50.12
PC3_IP=192.168.50.13

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambiar
MYSQL_REPL_USER=replicador
MYSQL_REPL_PASSWORD=cambiar
MYSQL_APP_USER=app_paqueteria
MYSQL_APP_PASSWORD=cambiar
MYSQL_DATABASE=paqueteria

# --- PostgreSQL ---
POSTGRES_PASSWORD=cambiar
POSTGRES_REPL_USER=replicador
POSTGRES_REPL_PASSWORD=cambiar
POSTGRES_DB=paqueteria

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambiar
MONGO_DATABASE=paqueteria

# --- Monitoreo ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar

# --- API ---
API_PUERTO=8080
