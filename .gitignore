# Variables de entorno con contraseñas (solo se sube .env.example)
.env
.env.*
!.env.example

# Llaves y certificados (keyfile del replica set de MongoDB, etc.)
*.key
*.pem
keyfile*

# Datos de las bases y del monitoreo (volúmenes locales)
datos/
data/
*.db

# Datos generados para la carga inicial
bd/generador/salida/

# Node.js
node_modules/
npm-debug.log*

# Logs
logs/
*.log

# Máquinas virtuales
*.vdi
*.vmdk
*.ova
*.iso

# Sistema operativo y editores
Thumbs.db
desktop.ini
.DS_Store
~$*
